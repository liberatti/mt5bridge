{
  "openapi": "3.0.3",
  "info": {
    "title": "MetaTrader 5 Flask REST API",
    "description": "Comprehensive REST API exposing 100% of the official Python MetaTrader 5 library methods in a headless Wine container.\n\n### Modules\n- **System**: MT5 lifecycle, connection, login, terminal and account status.\n- **Symbols & DOM**: Symbol listings, specifications, real-time ticks, and Depth of Market.\n- **Market Data**: Historical rates (OHLCV) and ticks with flexible filtering.\n- **Trading**: Market/pending order execution, positions management, margin & profit calculators.\n- **History**: Closed orders and deals history with date and ticket filters.",
    "version": "1.0.0",
    "contact": {
      "name": "API Support"
    }
  },
  "servers": [
    {
      "url": "/",
      "description": "Local API Server"
    }
  ],
  "tags": [
    {
      "name": "System",
      "description": "Terminal initialization, account authentication, and diagnostic endpoints"
    },
    {
      "name": "Symbols & DOM",
      "description": "Symbol search, detailed specifications, current ticks, and Market Depth"
    },
    {
      "name": "Market Data",
      "description": "Historical candlestick rates (OHLCV) and tick data retrieval"
    },
    {
      "name": "Trade",
      "description": "Order placement, position closure/modification, margin and profit calculation"
    },
    {
      "name": "History",
      "description": "Historical orders and trade deals execution logs"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    },
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/version": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Get MT5 Terminal Version",
        "description": "Returns version number, build, and release date of the MetaTrader 5 terminal.",
        "responses": {
          "200": {
            "description": "Version details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/last_error": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Get Last MT5 Error",
        "description": "Returns the last error code and error description from the MetaTrader 5 API.",
        "responses": {
          "200": {
            "description": "Last error details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/terminal_info": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Get Terminal Info",
        "description": "Returns detailed status and settings of the connected MetaTrader 5 terminal.",
        "responses": {
          "200": {
            "description": "Terminal information",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/account_info": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Get Account Info",
        "description": "Returns trading account status, balance, equity, margin, leverage, profit, and currency.",
        "responses": {
          "200": {
            "description": "Account details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/symbols_total": {
      "get": {
        "tags": [
          "Symbols & DOM"
        ],
        "summary": "Get Total Number of Symbols",
        "description": "Returns the total number of available financial instruments in the terminal.",
        "responses": {
          "200": {
            "description": "Symbols count",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/symbols_get": {
      "get": {
        "tags": [
          "Symbols & DOM"
        ],
        "summary": "Get Symbols List",
        "description": "Returns list of symbols with specifications. Can filter by group pattern (e.g. `*USD*`, `EUR*`, `*crypto*`).",
        "parameters": [
          {
            "name": "group",
            "in": "query",
            "description": "Group filter pattern",
            "required": false,
            "schema": {
              "type": "string",
              "default": "*"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of symbols",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/symbol_info/{symbol}": {
      "get": {
        "tags": [
          "Symbols & DOM"
        ],
        "summary": "Get Symbol Info",
        "description": "Returns complete financial instrument properties (point size, spread, digits, contract size, trade modes, margin rates).",
        "parameters": [
          {
            "name": "symbol",
            "in": "path",
            "required": true,
            "description": "Symbol name (e.g., EURUSD, BTCUSD)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Symbol specifications",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/symbol_info_tick/{symbol}": {
      "get": {
        "tags": [
          "Symbols & DOM"
        ],
        "summary": "Get Symbol Current Tick",
        "description": "Returns the most recent price tick (bid, ask, last, volume, time) for the specified symbol.",
        "parameters": [
          {
            "name": "symbol",
            "in": "path",
            "required": true,
            "description": "Symbol name",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Latest tick data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/symbol_select": {
      "post": {
        "tags": [
          "Symbols & DOM"
        ],
        "summary": "Select/Deselect Symbol in MarketWatch",
        "description": "Adds or removes a symbol from the Market Watch window.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SymbolSelectRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Selection result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/market_book_add": {
      "post": {
        "tags": [
          "Symbols & DOM"
        ],
        "summary": "Subscribe to Depth of Market (DOM)",
        "description": "Subscribes the terminal to market book events for the symbol.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MarketBookRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Subscription status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/market_book_get/{symbol}": {
      "get": {
        "tags": [
          "Symbols & DOM"
        ],
        "summary": "Get Depth of Market (DOM) Snapshots",
        "description": "Returns an array of DOM entries (buy/sell orders, prices, and volumes) for a subscribed symbol.",
        "parameters": [
          {
            "name": "symbol",
            "in": "path",
            "required": true,
            "description": "Symbol name",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "DOM entries list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/market_book_release": {
      "post": {
        "tags": [
          "Symbols & DOM"
        ],
        "summary": "Unsubscribe from Depth of Market (DOM)",
        "description": "Cancels subscription to market book events for the symbol.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MarketBookRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Unsubscription status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/copy_rates_from": {
      "get": {
        "tags": [
          "Market Data"
        ],
        "summary": "Copy Rates From Date",
        "description": "Returns historical bars starting from a specified date backward/forward.",
        "parameters": [
          {
            "name": "symbol",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "example": "EURUSD"
            }
          },
          {
            "name": "timeframe",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "M1",
              "enum": [
                "M1",
                "M2",
                "M3",
                "M4",
                "M5",
                "M6",
                "M10",
                "M12",
                "M15",
                "M20",
                "M30",
                "H1",
                "H2",
                "H3",
                "H4",
                "H6",
                "H8",
                "H12",
                "D1",
                "W1",
                "MN1"
              ]
            }
          },
          {
            "name": "date_from",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "example": "2026-01-01T00:00:00Z"
            }
          },
          {
            "name": "count",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Candlestick rates list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/copy_rates_from_pos": {
      "get": {
        "tags": [
          "Market Data"
        ],
        "summary": "Copy Rates From Position (Index)",
        "description": "Returns historical bars starting from an index offset (`start_pos=0` is current open candle).",
        "parameters": [
          {
            "name": "symbol",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "example": "EURUSD"
            }
          },
          {
            "name": "timeframe",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "M1"
            }
          },
          {
            "name": "start_pos",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0
            }
          },
          {
            "name": "count",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Candlestick rates list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/copy_rates_range": {
      "get": {
        "tags": [
          "Market Data"
        ],
        "summary": "Copy Rates in Date Range",
        "description": "Returns historical bars within a specific start and end date range.",
        "parameters": [
          {
            "name": "symbol",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "example": "EURUSD"
            }
          },
          {
            "name": "timeframe",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "M1"
            }
          },
          {
            "name": "date_from",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "example": "2026-01-01T00:00:00Z"
            }
          },
          {
            "name": "date_to",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "example": "2026-01-02T00:00:00Z"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Candlestick rates list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/copy_ticks_from": {
      "get": {
        "tags": [
          "Market Data"
        ],
        "summary": "Copy Ticks From Date",
        "description": "Returns tick history starting from a specified date.",
        "parameters": [
          {
            "name": "symbol",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "example": "EURUSD"
            }
          },
          {
            "name": "date_from",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "example": "2026-01-01T00:00:00Z"
            }
          },
          {
            "name": "count",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 100
            }
          },
          {
            "name": "flags",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "ALL",
              "enum": [
                "ALL",
                "INFO",
                "TRADE"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ticks list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/copy_ticks_range": {
      "get": {
        "tags": [
          "Market Data"
        ],
        "summary": "Copy Ticks in Date Range",
        "description": "Returns tick history within a start and end datetime range.",
        "parameters": [
          {
            "name": "symbol",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "example": "EURUSD"
            }
          },
          {
            "name": "date_from",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "example": "2026-01-01T00:00:00Z"
            }
          },
          {
            "name": "date_to",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "example": "2026-01-02T00:00:00Z"
            }
          },
          {
            "name": "flags",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "ALL",
              "enum": [
                "ALL",
                "INFO",
                "TRADE"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ticks list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/order/open": {
      "post": {
        "tags": [
          "Trade"
        ],
        "summary": "Open Market or Pending Order",
        "description": "Simplified high-level endpoint to place BUY, SELL, or pending limit/stop orders with SL and TP.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderOpenRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Order execution result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation or execution error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/order/close": {
      "post": {
        "tags": [
          "Trade"
        ],
        "summary": "Close Position",
        "description": "Closes an open position fully or partially by ticket ID.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderCloseRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Position closure result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/order/modify": {
      "post": {
        "tags": [
          "Trade"
        ],
        "summary": "Modify Position SL/TP",
        "description": "Updates the Stop Loss and Take Profit levels of an open position.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderModifyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Position modification result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/order/{ticket}": {
      "delete": {
        "tags": [
          "Trade"
        ],
        "summary": "Cancel Pending Order",
        "description": "Deletes/cancels an active pending order by its ticket ID.",
        "parameters": [
          {
            "name": "ticket",
            "in": "path",
            "required": true,
            "description": "Order ticket ID",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cancellation result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/order_send": {
      "post": {
        "tags": [
          "Trade"
        ],
        "summary": "Send Raw MT5 Order Request",
