        "responses": {
          "200": {
            "description": "Calculated profit amount",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/positions_total": {
      "get": {
        "tags": [
          "Trade"
        ],
        "summary": "Get Total Number of Open Positions",
        "description": "Returns the number of currently open positions.",
        "responses": {
          "200": {
            "description": "Positions count",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/positions_get": {
      "get": {
        "tags": [
          "Trade"
        ],
        "summary": "Get Open Positions List",
        "description": "Returns array of active open positions. Can filter by symbol, group pattern, or position ticket.",
