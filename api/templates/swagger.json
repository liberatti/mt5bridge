        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderSendRawRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Raw order result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/order_check": {
      "post": {
        "tags": [
          "Trade"
