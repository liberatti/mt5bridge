  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "API Key authentication passed via the 'x-api-key' request header."
      },
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT Bearer Token authentication."
      }
    },
    "schemas": {
      "ApiResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 200
          },
          "data": {
            "type": "object",
            "nullable": true
          }
        }
      },
      "ApiErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 400
          },
          "message": {
            "type": "string",
            "example": "Bad Request / Validation Error"
          },
          "details": {
            "type": "string",
            "nullable": true,
            "example": "Detailed error context"
          },
          "url": {
            "type": "string",
            "example": "http://localhost:5000/api/..."
          },
          "method": {
            "type": "string",
            "example": "POST"
          }
        }
      },
      "SymbolSelectRequest": {
        "type": "object",
        "required": [
          "symbol"
        ],
        "properties": {
          "symbol": {
            "type": "string",
            "example": "EURUSD"
          },
          "enable": {
            "type": "boolean",
            "default": true,
            "description": "True to add, False to remove"
          }
        }
      },
      "MarketBookRequest": {
        "type": "object",
        "required": [
          "symbol"
        ],
        "properties": {
          "symbol": {
            "type": "string",
            "example": "EURUSD"
          }
        }
      },
      "OrderOpenRequest": {
        "type": "object",
        "required": [
          "symbol",
          "volume"
        ],
        "properties": {
          "symbol": {
            "type": "string",
            "example": "EURUSD"
          },
          "type": {
            "type": "string",
            "enum": [
              "BUY",
              "SELL",
              "BUY_LIMIT",
              "SELL_LIMIT",
              "BUY_STOP",
              "SELL_STOP",
              "BUY_STOP_LIMIT",
              "SELL_STOP_LIMIT"
            ],
            "default": "BUY",
            "description": "Order type string"
          },
          "volume": {
            "type": "number",
            "example": 0.01
          },
          "price": {
            "type": "number",
            "description": "Required for limit/stop orders. Optional for market orders (defaults to current ask/bid)",
            "example": 1.085
          },
          "sl": {
            "type": "number",
            "description": "Stop Loss price level",
            "example": 1.08
          },
          "tp": {
            "type": "number",
            "description": "Take Profit price level",
            "example": 1.095
          },
          "deviation": {
            "type": "integer",
            "default": 20,
            "description": "Maximum price slippage in points"
          },
          "comment": {
            "type": "string",
            "default": "API Order"
          },
          "magic": {
            "type": "integer",
            "default": 0,
            "description": "Expert Advisor Magic Number ID"
          },
          "type_filling": {
            "type": "integer",
            "description": "Order execution filling mode (0 = FOK, 1 = IOC, 2 = RETURN, 3 = BOC)",
            "example": 1
          }
        }
      },
      "OrderCloseRequest": {
        "type": "object",
        "required": [
          "ticket"
        ],
        "properties": {
          "ticket": {
            "type": "integer",
            "description": "Position Ticket ID to close",
            "example": 1234567
          },
          "volume": {
            "type": "number",
            "description": "Volume to close (default: closes entire position volume)",
            "example": 0.01
          },
          "deviation": {
            "type": "integer",
            "default": 20
          },
          "comment": {
            "type": "string",
            "default": "API Close"
          }
        }
      },
      "OrderModifyRequest": {
        "type": "object",
        "required": [
          "ticket"
        ],
        "properties": {
          "ticket": {
            "type": "integer",
            "description": "Position Ticket ID",
            "example": 1234567
          },
          "sl": {
            "type": "number",
            "description": "New Stop Loss level",
            "example": 1.082
          },
          "tp": {
            "type": "number",
            "description": "New Take Profit level",
            "example": 1.098
          }
        }
      },
      "OrderSendRawRequest": {
        "type": "object",
        "required": [
          "action",
          "symbol",
          "volume",
          "type"
        ],
        "properties": {
          "action": {
            "type": "integer",
            "description": "1 = TRADE_ACTION_DEAL, 5 = TRADE_ACTION_PENDING, 6 = TRADE_ACTION_SLTP, 8 = TRADE_ACTION_REMOVE",
            "example": 1
          },
          "symbol": {
            "type": "string",
            "example": "EURUSD"
          },
          "volume": {
            "type": "number",
            "example": 0.1
          },
          "type": {
            "type": "integer",
            "description": "0 = ORDER_TYPE_BUY, 1 = ORDER_TYPE_SELL",
            "example": 0
          },
          "price": {
            "type": "number",
            "example": 1.085
          },
          "sl": {
            "type": "number",
            "example": 1.08
          },
          "tp": {
            "type": "number",
            "example": 1.09
          },
          "deviation": {
            "type": "integer",
            "example": 20
          },
          "magic": {
            "type": "integer",
            "example": 10001
          },
          "comment": {
            "type": "string",
            "example": "Raw trade request"
          },
          "type_time": {
            "type": "integer",
            "example": 0
          },
          "type_filling": {
            "type": "integer",
            "example": 1
          }
        }
      },
      "OrderCalcMarginRequest": {
        "type": "object",
        "required": [
          "action",
          "symbol",
          "volume",
          "price"
        ],
        "properties": {
          "action": {
            "type": "string",
            "description": "BUY or SELL (or integer code 0/1)",
            "example": "BUY"
          },
          "symbol": {
            "type": "string",
            "example": "EURUSD"
          },
          "volume": {
            "type": "number",
            "example": 1.0
          },
          "price": {
            "type": "number",
            "example": 1.085
          }
        }
      },
      "OrderCalcProfitRequest": {
        "type": "object",
        "required": [
          "action",
          "symbol",
          "volume",
          "price_open",
          "price_close"
        ],
        "properties": {
          "action": {
            "type": "string",
            "description": "BUY or SELL (or integer code 0/1)",
            "example": "BUY"
          },
          "symbol": {
            "type": "string",
            "example": "EURUSD"
          },
          "volume": {
            "type": "number",
            "example": 1.0
          },
          "price_open": {
            "type": "number",
            "example": 1.08
          },
          "price_close": {
            "type": "number",
            "example": 1.085
          }
        }
      }
    }
  }
}